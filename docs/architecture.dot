digraph RiskEngineArchitecture {
    rankdir=TB;
    newrank=true;
    nodesep=0.3;
    ranksep=0.35;
    fontname="Helvetica,Arial,sans-serif";
    node [fontname="Helvetica,Arial,sans-serif", fontsize=10, shape=box, style="filled,rounded", color="#333333", fillcolor="#FFFFFF"];
    edge [fontname="Helvetica,Arial,sans-serif", fontsize=8, color="#555555"];

    subgraph cluster_sources {
        label="1 · Text sources"; style="filled,rounded"; fillcolor="#E8F0FE"; color="#1A73E8"; fontsize=12;
        news   [label="News headlines\nBenzinga company + market-wide\nfeeds (2018-2020)"];
        social [label="Social posts\nStock Tweets dataset\n(cashtags / @mentions)"];
        gdelt  [label="Global event feed\nGDELT 2.0 DOC API\n(live, snapshot fallback)"];
    }

    subgraph cluster_ingest {
        label="2 · Ingestion & linking"; style="filled,rounded"; fillcolor="#FEF7E0"; color="#F9AB00"; fontsize=12;
        adapters [label="Source adapters\nUTC timestamps · stable doc_id\nDocument schema"];
        linker   [label="Entity linker\n20-stock S&P 100 universe\ncashtags · aliases · context rules"];
    }

    subgraph cluster_labels {
        label="Offline label factory (training time)"; style="filled,rounded"; fillcolor="#FCE8E6"; color="#EA4335"; fontsize=12;
        fpb    [label="FinancialPhraseBank\nhuman sentiment labels", style="filled,rounded,dashed"];
        zs     [label="Event labels\nBART-large-MNLI zero-shot\n⊕ keyword rules"];
        car    [label="Impact labels (event study, [0,+1])\ncompany: CAR vs SPY ÷ 60d idio-vol\nmarket-wide: SPY move ÷ 60d vol\n→ train-set deciles 1-10"];
        splits [label="Chronological split\ntrain < 2019-07 < val < 2019-11 < test"];
    }

    subgraph cluster_model {
        label="3 · Multi-task risk model"; style="filled,rounded"; fillcolor="#E6F4EA"; color="#137333"; fontsize=12;
        encoder [label="DistilRoBERTa encoder\n(fine-tuned, mean-pooled)", shape=component, fillcolor="#C8E6C9"];
        h_sent  [label="Sentiment head\ntanh → [-1, 1]"];
        h_event [label="Event head\nsoftmax · 9 classes"];
        h_imp   [label="Impact head\nμ ∈ [1,10] + σ (Gaussian NLL)"];
        fallback [label="TF-IDF + linear baseline\n(automatic fallback)", style="filled,rounded,dashed"];
    }

    subgraph cluster_serve {
        label="4 · Signal delivery"; style="filled,rounded"; fillcolor="#F3E8FD"; color="#9334E6"; fontsize=12;
        signal [label="Signal\nsentiment_score · event_type · impact_score\n+ confidences · ticker · timestamp", shape=note, fillcolor="#E1BEE7"];
        api    [label="FastAPI\n/analyze · /signals · /signals/{ticker}\n/ingest/gdelt · /modules/*"];
        file   [label="File sink\ndata/samples/signals.jsonl"];
    }

    subgraph cluster_modules {
        label="5 · Downstream risk modules"; style="filled,rounded"; fillcolor="#FFF3E0"; color="#E65100"; fontsize=12;
        modA [label="Module A · Index rebalancer\nEWMA sentiment → w ∝ exp(λs)\ncaps · turnover budget · costs"];
        modB [label="Module B · Stress test\nimpact ≥ 8 & macro-type event →\nshock vector → bonds · loans (ECL) ·\nderivatives → CET1"];
        dash [label="Streamlit dashboard\nlive engine · weights over time ·\nbefore/after stress · model metrics", fillcolor="#FFE0B2"];
    }

    news -> adapters; social -> adapters; gdelt -> adapters;
    adapters -> linker;
    linker -> encoder [label="inference"];
    encoder -> h_sent; encoder -> h_event; encoder -> h_imp;
    h_sent -> signal; h_event -> signal; h_imp -> signal;
    fallback -> signal [style=dashed];
    signal -> api; signal -> file;
    api -> modA [label="sentiment_score"];
    api -> modB [label="event_type, impact_score"];
    file -> modA; file -> modB;
    modA -> dash; modB -> dash; api -> dash;

    fpb -> splits [style=dashed];
    adapters -> zs [style=dashed, label="training rows"];
    adapters -> car [style=dashed];
    zs -> splits [style=dashed]; car -> splits [style=dashed];
    splits -> encoder [style=dashed, label="fine-tune"];
}

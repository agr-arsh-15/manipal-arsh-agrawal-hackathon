# Copy to .env and fill in. Never commit .env.

# Kaggle API (https://www.kaggle.com/settings -> API -> Create New Token)
KAGGLE_USERNAME=
KAGGLE_KEY=

# NewsAPI.org Developer (free) plan — live demo only (24h delay, 100 req/day)
NEWSAPI_KEY=

# Optional: Alpha Vantage fallback for prices
ALPHAVANTAGE_API_KEY=

# Optional: Hugging Face Hub (only needed to publish/download model weights)
HF_TOKEN=
